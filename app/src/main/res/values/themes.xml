<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.AppTheme.Light" parent="Theme.Material3.DynamicColors.Light.Rikka">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/background_color</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:textAppearanceListItem">?textAppearanceSubtitle1</item>
        <item name="android:colorAccent">@color/whatsapp_green</item>
        <item name="android:colorControlActivated">@color/whatsapp_green</item>
        <item name="android:listDivider">@android:color/transparent</item>
        <item name="android:divider">@android:color/transparent</item>
        <item name="android:dividerHeight">0dp</item>
        <item name="toolbarStyle">@style/ModernToolbarStyle</item>
        <item name="materialSwitchStyle">@style/ModernSwitchStyle</item>
        <item name="switchStyle">@style/ModernSwitchStyle</item>
        <item name="preferenceCategoryStyle">@style/ModernPreferenceCategoryStyle</item>
    </style>

    <style name="Theme.Light" parent="Base.AppTheme.Light" />

    <style name="Base.AppTheme" parent="Theme.Material3.DynamicColors.Dark.Rikka">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textAppearanceListItem">?textAppearanceSubtitle1</item>
        <item name="android:colorAccent">@color/whatsapp_green</item>
        <item name="android:colorControlActivated">@color/whatsapp_green</item>
        <item name="android:statusBarColor">@color/background_color</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:listDivider">@android:color/transparent</item>
        <item name="android:divider">@android:color/transparent</item>
        <item name="android:dividerHeight">0dp</item>
        <item name="toolbarStyle">@style/ModernToolbarStyle</item>
        <item name="materialSwitchStyle">@style/ModernSwitchStyle</item>
        <item name="switchStyle">@style/ModernSwitchStyle</item>
        <item name="preferenceCategoryStyle">@style/ModernPreferenceCategoryStyle</item>
    </style>

    <style name="ModernPreferenceCategoryStyle" parent="@style/Preference.Category">
        <item name="android:layout_marginTop">0dp</item>
        <item name="android:layout_marginBottom">0dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:background">@null</item>
        <item name="allowDividerAbove">false</item>
        <item name="allowDividerBelow">false</item>
    </style>

    <style name="ModernSwitchStyle" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/switch_thumb_tint</item>
        <item name="trackTint">@color/switch_track_tint</item>
        <item name="trackDecorationTint">@android:color/transparent</item>
    </style>

    <style name="MyActionBar" parent="@style/Widget.Material3.ActionBar.Solid">
        <item name="background">?colorOnSecondary</item>
        <item name="contentInsetStart">5dp</item>
    </style>

    <style name="Theme" parent="Base.AppTheme" />

    <style name="DeviceInfoDialogLabel">
        <item name="android:textAlignment">viewStart</item>
        <item name="android:textAppearance">@style/TextAppearance.MaterialComponents.Body1</item>
        <item name="android:textColor">?android:attr/textColorSecondary</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="DeviceInfoDialogValue">
        <item name="android:textAlignment">viewStart</item>
        <item name="android:textAppearance">@style/TextAppearance.MaterialComponents.Body2</item>
        <item name="android:paddingBottom">@dimen/spacing_large</item>
    </style>

    <style name="StatusCardStyle" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/card_radius_large</item>
        <item name="cardElevation">@dimen/card_elevation_high</item>
        <item name="android:layout_marginBottom">@dimen/spacing_medium</item>
        <item name="contentPadding">@dimen/spacing_medium</item>
        <item name="cardBackgroundColor">#1AFFFFFF</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">#33FFFFFF</item>
    </style>

    <style name="StatusCardTitle">
        <item name="android:textAppearance">?textAppearanceTitleMedium</item>
        <item name="android:textColor">@color/text_on_gradient</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="StatusCardSummary">
        <item name="android:textAppearance">?textAppearanceBodyMedium</item>
        <item name="android:textColor">@color/text_on_gradient</item>
        <item name="android:alpha">0.9</item>
    </style>

    <style name="ModernButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:minWidth">@dimen/button_min_width</item>
        <item name="cornerRadius">@dimen/card_radius_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="ModernButton.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:minWidth">@dimen/button_min_width</item>
        <item name="cornerRadius">@dimen/card_radius_medium</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="BottomNavStyle" parent="Widget.Material3.BottomNavigationView">
        <item name="itemActiveIndicatorStyle">@style/NavActiveIndicator</item>
        <item name="labelVisibilityMode">unlabeled</item>
        <item name="itemIconTint">@color/nav_item_colors</item>
        <item name="itemTextColor">@color/nav_item_colors</item>
        <item name="itemIconSize">24dp</item>
        <item name="android:minHeight">58dp</item>
        <item name="elevation">20dp</item>
    </style>

    <style name="NavActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">#2600A884</item>
        <item name="android:width">48dp</item>
        <item name="android:height">36dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Material3.Corner.Full</item>
    </style>

</resources>
