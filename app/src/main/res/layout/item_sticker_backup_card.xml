<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/card_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Row: Icon + Title + Size Badge -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Zip Icon Container -->
            <FrameLayout
                android:id="@+id/backup_icon_box"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_badge_category">

                <ImageView
                    android:id="@+id/iv_backup_type"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    app:srcCompat="@drawable/ic_round_backup_24"
                    app:tint="@color/whatsapp_green"
                    tools:ignore="ContentDescription" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_toEndOf="@id/backup_icon_box"
                android:layout_toStartOf="@+id/tv_backup_size"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_backup_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="middle"
                    android:fontFamily="sans-serif-medium"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textSize="14.5sp"
                    android:textStyle="bold"
                    tools:text="WA_Stickers_whatsapp_2.26.33.76.zip" />

                <TextView
                    android:id="@+id/tv_backup_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/text_secondary"
                    android:textSize="11.5sp"
                    tools:text="29 Agu 2026, 19:20 WIB" />
            </LinearLayout>

            <!-- Size / Format Badge -->
            <TextView
                android:id="@+id/tv_backup_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/category_badge_background"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:textColor="@color/whatsapp_green"
                android:textSize="10.5sp"
                android:textStyle="bold"
                tools:text="254 KB" />
        </RelativeLayout>

        <!-- Middle Info Pill Row: Version & Package -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_backup_pkg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/version_badge_background"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp"
                tools:text="com.whatsapp" />

            <TextView
                android:id="@+id/tv_backup_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/version_badge_background"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:textColor="@color/text_secondary"
                android:textSize="10.5sp"
                tools:text="v2.26.33.76" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="@color/card_divider" />

        <!-- Actions Row: Restore, Share, Delete -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Quick Restore Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_item_restore"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/whatsapp_green"
                android:fontFamily="sans-serif-medium"
                android:minHeight="42dp"
                android:paddingStart="8dp"
                android:paddingTop="6dp"
                android:paddingEnd="8dp"
                android:paddingBottom="6dp"
                android:text="Pulihkan"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_restore"
                app:iconGravity="textStart"
                app:iconSize="16dp"
                app:iconTint="#FFFFFF"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <!-- Share Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_item_share"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:backgroundTint="@color/card_bg"
                android:fontFamily="sans-serif-medium"
                android:minHeight="42dp"
                android:paddingStart="12dp"
                android:paddingTop="6dp"
                android:paddingEnd="12dp"
                android:paddingBottom="6dp"
                android:text="Bagikan"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:cornerRadius="10dp"
                app:icon="@drawable/ic_round_share_24"
                app:iconGravity="textStart"
                app:iconSize="16dp"
                app:iconTint="@color/whatsapp_green"
                app:strokeColor="@color/card_border"
                app:strokeWidth="1dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <!-- Delete Button -->
            <ImageButton
                android:id="@+id/btn_item_delete"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_btn_circle_translucent"
                app:srcCompat="@drawable/ic_delete"
                app:tint="@color/log_error"
                tools:ignore="ContentDescription" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
