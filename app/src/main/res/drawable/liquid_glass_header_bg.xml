<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glass container with translucent background and subtle stroke -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#26121D15" />
            <stroke
                android:width="1dp"
                android:color="#33FFFFFF" />
            <corners
                android:bottomLeftRadius="20dp"
                android:bottomRightRadius="20dp" />
        </shape>
    </item>
    <!-- Top specular highlight / liquid reflection gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#25FFFFFF"
                android:centerColor="#0AFFFFFF"
                android:endColor="#00000000"
                android:type="linear" />
            <corners
                android:bottomLeftRadius="20dp"
                android:bottomRightRadius="20dp" />
        </shape>
    </item>
</layer-list>
